{
  "name": "main-character-club-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,studio \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "test:cloud": "tsx scripts/cloud-smoke.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@remotion/bundler": "4.0.537",
    "@remotion/player": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "multer": "2.4.0",
    "openai": "7.39.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "playwright": "1.64.1",
