# Server only. Never use a VITE_ prefix for secrets.
MCC_OPENAI_API_KEY=
MCC_EDIT_PROVIDER=codex
MCC_EDIT_MODEL=gpt-4.1-mini
PORT=3001
# Use the installed browser, or omit to let Remotion acquire its browser.
REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
# Required for a publicly hosted production instance. Keep these server-side.
MCC_ADMIN_PASSWORD=
MCC_SESSION_SECRET=
# Cloud deployment mounts its persistent disk here; omit for local .data/.
# MCC_DATA_DIR=/var/data
MCC_RENDER_CONCURRENCY=1

# Low-cost pilot: increase only after validating a short spoken test.
MCC_AI_MAX_SOURCE_SECONDS=60
MCC_TRANSLATION_MODEL=gpt-4.1-mini
